APP_NAME=Andallo
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:43123

APP_LOCALE=id
APP_FALLBACK_LOCALE=id
APP_FAKER_LOCALE=id_ID

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=andallo
DB_USERNAME=andallo
DB_PASSWORD=andallo_secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=database

MAIL_MAILER=log
MAIL_FROM_ADDRESS="bantuan@andallo.test"
MAIL_FROM_NAME="${APP_NAME}"

# WhatsApp. Default simulasi. Jangan isi token produksi di repo.
WHATSAPP_DRIVER=simulation
WHATSAPP_CLOUD_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_API_VERSION=v21.0

# Pembayaran. manual = transfer dan unggah bukti. Webhook tidak aktif tanpa rahasia.
PAYMENT_DRIVER=manual
PAYMENT_WEBHOOK_SECRET=

ANDALLO_REQUIRE_ADMIN_REVIEW=true
ANDALLO_PROVIDER_RESPONSE_MINUTES=2
ANDALLO_PAYMENT_WINDOW_MINUTES=1440
ANDALLO_PAYMENT_REVIEW_HOURS=24
ANDALLO_REFUND_BEFORE_START_PERCENT=100

VITE_APP_NAME="${APP_NAME}"
